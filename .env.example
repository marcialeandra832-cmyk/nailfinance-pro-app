# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_FIREBASE_DATABASE_URL: Optional custom URL for your Firebase Realtime Database.
VITE_FIREBASE_DATABASE_URL="https://your-database-name.firebaseio.com"

# KIWIFY CHECKOUT & INTEGRATION CONFIGURATION
VITE_KIWIFY_CHECKOUT_MENSAL_URL="https://pay.kiwify.com.br/checkout-mensal"
VITE_KIWIFY_CHECKOUT_ANUAL_URL="https://pay.kiwify.com.br/checkout-anual"
VITE_KIWIFY_PORTAL_URL="https://dashboard.kiwify.com.br/"

# KIWIFY WEBHOOK SECRET / TOKEN FOR SECURE WEBHOOK VALIDATION
KIWIFY_WEBHOOK_SECRET="sua_chave_secreta_webhook_kiwify"

# WHATSAPP SUPPORT NUMBER
